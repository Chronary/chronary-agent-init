{
  "name": "@chronary/agent-init",
  "version": "0.1.1",
  "description": "One-liner bootstrap for AI agents: sign up, verify OTP, create a smoke calendar. `npx @chronary/agent-init`.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "chronary-agent-init": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chronary",
    "calendar",
    "ai",
    "ai-agent",
    "bootstrap",
    "self-signup",
    "agent-init"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chronary/chronary-cli"
  },
  "homepage": "https://chronary.ai",
  "bugs": {
    "url": "https://github.com/Chronary/chronary/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
